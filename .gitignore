# Private or generated content. The public repository holds code only.
/data/
site/data/*
!site/data/cases.json
!site/data/areas.json
!site/data/photo_links.json
!site/data/cases/
site/photos/
publish/
*.log

# Local environments and caches
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
